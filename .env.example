GEMINI_API_KEY=
# Any Gemini model that supports tool calling. flash-lite: ~2s per turn; gemini-3.5-flash was
# 20-90s per turn (busy servers) as of Nov 2026.
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/trucking
# dev enables the /dev routes (raw shipment lookup, no verification). Set to prod to hide them.
APP_ENV=dev
# Optional: pin the business date (YYYY-MM-DD) so seeds and evals are reproducible.
APP_TODAY=
# false = no Python rule checks. Only for measuring the v0 baseline.
ENFORCE_RULES=true
